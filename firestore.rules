rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── digitalInvitations/{groomUid} ────────────────────────────────────────
    // All digital invitation data for a groom lives under one path:
    //   digitalInvitations/{groomUid}                         — background/media (doc)
    //   digitalInvitations/{groomUid}/guests/{guestId}        — RSVP list
    //   digitalInvitations/{groomUid}/photographerFiles/{id}  — photographer uploads
    //   digitalInvitations/{groomUid}/designRequests/{reqId}  — design workflow
    //
    // Parent doc: OWNER/ADMIN read only. Guests never read this doc directly —
    // they fetch the wedding date + media through the server-mediated, approved-
    // only, freeze-gated GET /digital/:uid/public endpoint, which returns a
    // PUBLIC_DESIGN_FIELDS-allowlisted projection. A blanket public read here
    // leaked legacy (pre-v2) grooms' full design payload (brideName, venue,
    // giftIban, story, …) plus design-workflow metadata straight off the parent,
    // bypassing the endpoint's allowlist/approval/freeze gates. The
    // photographerFiles child rule below uses a rule-internal get() of this doc,
    // which is NOT subject to this read rule, so gating it changes nothing there.
    match /digitalInvitations/{groomUid} {
      allow read: if request.auth != null
        && (request.auth.uid == groomUid || request.auth.token.role == 'admin');
      allow write: if request.auth != null
        && (request.auth.uid == groomUid || request.auth.token.role == 'admin');

      // Photographer files are public READ only when the groom has flipped the
      // photographerPublished flag. The face-matching guest page relies on this.
      match /photographerFiles/{fileId} {
        allow read: if
          get(/databases/$(database)/documents/digitalInvitations/$(groomUid)).data.photographerPublished == true
          || (request.auth != null
              && (request.auth.uid == groomUid || request.auth.token.role == 'admin'));
        allow write: if request.auth != null
          && (request.auth.uid == groomUid || request.auth.token.role == 'admin');
      }

      // Guests + designs + designRequests + everything else: groom/admin only.
      match /guests/{guestId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == groomUid || request.auth.token.role == 'admin');
      }
      // Designs subcollection — one full invitation design each (a groom may
      // have several). Owner/admin only; public reads are server-mediated.
      match /designs/{designId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == groomUid || request.auth.token.role == 'admin');
      }
      match /designRequests/{reqId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == groomUid || request.auth.token.role == 'admin');
      }

      // BIOMETRIC face data — never client-readable, not even by the groom or
      // admin. Only Cloud Functions (Admin SDK bypasses rules) touch these:
      //   photoFaces/{fileId}    — per-photo face descriptors (indexing trigger)
      //   guestFaces/{tokenHash} — guest enrollment descriptors (TTL'd on expireAt)
      // The default-deny catch-all already covers them; these explicit matches
      // exist so nobody ever "opens up" the subtree by accident.
      match /photoFaces/{fileId} {
        allow read, write: if false;
      }
      match /guestFaces/{tokenHash} {
        allow read, write: if false;
      }
      // People-gallery data — also server-mediated only. peopleClusters carry
      // face boxes + FaceIds (biometric-adjacent); galleryConfig + jobStatus are
      // edited via the API and the public gallery reads through a grant.
      match /peopleClusters/{clusterId} {
        allow read, write: if false;
      }
      match /galleryConfig/{doc} {
        allow read, write: if false;
      }
      match /jobStatus/{doc} {
        allow read, write: if false;
      }
    }

    // Admin reads every design / design request across all grooms via collectionGroup.
    match /{path=**}/designs/{designId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /{path=**}/designRequests/{reqId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
    }

    // App-wide config (e.g. appConfig/demoDesign = the published demo snapshot).
    // Server-mediated only: the Admin SDK writes it on publish and the public
    // demo reads it through the no-auth REST endpoint, never via direct Firestore.
    match /appConfig/{doc} {
      allow read, write: if false;
    }

    // Security events — server-only (Admin SDK). The admin Security page reads
    // them via the /admin/security REST API, never directly. Explicit deny
    // mirrors appConfig / the biometric subtrees.
    match /securityEvents/{id} {
      allow read, write: if false;
    }

    // Default deny — all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
