# Cloud Functions environment — copy to `.env.local` for the emulator, and set
# the same keys via Secret Manager / `.env.dawa-aa793` for production. The
# WhatsApp keys are READ FROM process.env by whatsapp.ts / whatsappInvite.ts;
# until they are set, every WhatsApp send is a safe no-op and the admin Send tab
# transparently falls back to opening a wa.me tab.

# ─── WhatsApp Business Cloud API (Meta) ──────────────────────────────────────
# From the Meta App dashboard → WhatsApp → API Setup.
WHATSAPP_TOKEN=                 # Access token (temp 24h for first test → permanent System-User token)
WHATSAPP_PHONE_ID=             # Phone number ID of the sending number (test number to start)
WHATSAPP_VERIFY_TOKEN=         # Any random string; paste the same value into the Meta webhook UI
WHATSAPP_APP_SECRET=           # App → Settings → Basic → App Secret (verifies inbound webhook POSTs)

# Origin used to build invite links in auto-sent messages (no trailing slash).
PUBLIC_BASE_URL=https://dawa.to

# ─── Approved invite templates (production sends) ────────────────────────────
# Names of the message templates you submitted in Meta → WhatsApp → Message
# Templates. One per (type × language). LEAVE BLANK to use the free-form text
# fallback (only delivers inside the 24h window — good for the first test).
# Each template needs: body var {{1}} = guest name, and a URL button whose base
# matches PUBLIC_BASE_URL (keep these in sync if you change the domain):
#   digital  → button URL  https://dawa.to/d/{{1}}      (suffix = groomUsername/token)
#   physical → button URL  https://dawa.to/invite/{{1}} (suffix = token)
WHATSAPP_INVITE_TEMPLATE_PHYSICAL_AR=
WHATSAPP_INVITE_TEMPLATE_PHYSICAL_HE=
WHATSAPP_INVITE_TEMPLATE_DIGITAL_AR=
WHATSAPP_INVITE_TEMPLATE_DIGITAL_HE=

# ─── "Your photos are ready" template (existing photo-share flow) ────────────
WHATSAPP_YOURPHOTOS_TEMPLATE=
WHATSAPP_YOURPHOTOS_TEMPLATE_LANG=ar
