# Firebase web config — these values are PUBLIC by design. Security is enforced
# by Auth + Database/Storage rules + App Check, not by hiding this config.
# Copy to `.env` and fill in your project's values (Project Settings → General).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key for Firebase App Check (web).
# Create one at https://console.cloud.google.com/security/recaptcha
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=6LekWOssAAAAAI3EjkKLqBjmer3BePT5ohOY81lJ

# Set to `1` to point the client at the local Firebase Emulator Suite
# (recommended for dev; do NOT set in production).
VITE_USE_EMULATORS=1
