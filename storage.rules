rules_version = '2';

// Proof photos for delivered invitations.
//   path: /proofs/{groomUid}/{guestId}/{filename}.jpg
//
// Writes are only accepted from the driver currently assigned to that groom
// (verified via the driver's custom claim `assignedGrooms` map, which is set
// when a driver picks a groom via the assignDriverToGroom callable function).
// Reads are allowed for the owning groom and for admins.
service firebase.storage {
  match /b/{bucket}/o {

    match /proofs/{groomUid}/{guestId}/{file} {
      allow read: if request.auth != null
                  && ( request.auth.uid == groomUid
                       || request.auth.token.role == 'admin' );

      allow write: if request.auth != null
                   && request.resource.size < 6 * 1024 * 1024            // 6 MB cap
                   && request.resource.contentType.matches('image/.*')
                   && request.auth.token.assignedGrooms[groomUid] == true;
    }

    // Invitation media (multi-image/video gallery for the digital invitation).
    // Recursive so per-design paths `digitalMedia/{groomUid}/{designId}/{file}`
    // and legacy flat `digitalMedia/{groomUid}/{file}` both match.
    // PUBLIC READ at all times — guests opening their invite link must be able
    // to view these without auth. Write restricted to the groom/admin.
    match /digitalMedia/{groomUid}/{allPaths=**} {
      allow read: if true;
      // Write restricted to groom/admin. Backend uploads go through the Admin SDK
      // (bypasses these rules); this gate hardens any DIRECT client write. Require
      // image/video and REJECT SVG — this bucket is public-read, so a script-bearing
      // image/svg+xml here would be a JS/phishing host on the Google Storage domain.
      allow write: if request.auth != null
                   && (request.auth.uid == groomUid || request.auth.token.role == 'admin')
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('(image|video)/.*')
                   && !request.resource.contentType.matches('image/svg.*');
    }

    // Photographer uploads — photos, videos, and files from the wedding shoot.
    // PUBLIC READ when the groom has set photographerPublished == true on
    // their Firestore doc. The face-matching guest page reads images directly
    // from Storage URLs, so the photos must be downloadable while published.
    match /photographerFiles/{groomUid}/{file} {
      allow read: if
        firestore.get(/databases/(default)/documents/digitalInvitations/$(groomUid)).data.photographerPublished == true
        || (request.auth != null
            && (request.auth.uid == groomUid || request.auth.token.role == 'admin'));
      // Backend uploads use the Admin SDK (bypasses rules); this gate hardens any
      // DIRECT client write. photographerFiles is public-read once published, so
      // require image/video and REJECT SVG (script-bearing SVG = JS/phishing host).
      allow write: if request.auth != null
                   && (request.auth.uid == groomUid || request.auth.token.role == 'admin')
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('(image|video)/.*')
                   && !request.resource.contentType.matches('image/svg.*');
    }


    // Design mockups — admin/designer uploads, groom can read.
    match /designMockups/{groomUid}/{reqId}/{file} {
      allow read: if request.auth != null
                  && (request.auth.uid == groomUid || request.auth.token.role == 'admin');
      allow write: if request.auth != null
                   && (request.auth.uid == groomUid || request.auth.token.role == 'admin')
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default deny for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
