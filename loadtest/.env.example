# Load-test credentials — copy to loadtest/.env and fill in real values.
# loadtest/.env is gitignored (covered by the root ".env" rule). These are read
# by both the CLI (run.py) and the dashboard, and injected into the locust
# subprocess as env vars. They are NEVER written to run_config.json or presets.
#
# Emulator seed (backend/scripts/seed-emulator.cjs) creates: admin/Admin1234, groom/Groom1234
# Production defaults (locustfile.py): admin/DawaAdmin2026, groom/DawaGroom2026

LOADTEST_ADMIN_USER=admin
LOADTEST_ADMIN_PASS=DawaAdmin2026
LOADTEST_GROOM_USER=groom
LOADTEST_GROOM_PASS=DawaGroom2026
