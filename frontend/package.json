{
  "name": "dawa-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "دعوة — wedding-invitation distribution app (Vite React frontend)",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "cross-env VITE_API_BASE_URL=http://127.0.0.1:5001/dawa-aa793/us-central1/api VITE_USE_EMULATORS=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.5.5",
    "@aws-amplify/ui-react-liveness": "^3.2.0",
    "@sentry/react": "^8.55.2",
    "aws-amplify": "^6.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1",
    "recharts": "^2.15.4",
    "three": "^0.169.0",
    "web-vitals": "^5.3.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@capsizecss/metrics": "^4.1.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.11",
    "vitest": "^4.1.6"
  }
}
