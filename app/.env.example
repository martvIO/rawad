# Copy to `app/.env` and adjust. These are PUBLIC build-time URLs (no secrets).
#
# The Capacitor WebView is not same-origin with Firebase Hosting, so the web
# app's `/api` rewrite does not exist here — point at the API function's
# ABSOLUTE Cloud Run URL (same origin used for the live-location SSE stream).
VITE_API_BASE_URL=https://api-je74slt7ra-uc.a.run.app
VITE_SSE_BASE_URL=https://api-je74slt7ra-uc.a.run.app
VITE_INVITE_BASE_URL=https://invite.dawa.to

# For DEVICE/EMULATOR testing against the Firebase emulator instead of prod,
# create app/.env.development with the host the device can reach, e.g.:
#   Android emulator:  http://10.0.2.2:5001/dawa-aa793/us-central1/api
#   Physical device :  http://<your-LAN-IP>:5001/dawa-aa793/us-central1/api
