{
  "name": "dawa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "دعوة — wedding-invitation distribution app",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "cross-env VITE_API_BASE_URL=http://127.0.0.1:5001/dawa-aa793/us-central1/api VITE_USE_EMULATORS=1 vite",
    "dev:full": "concurrently -k -n EMU,VITE -c blue,green \"npm:emulators:build\" \"npm:dev:emulator\"",
    "emulators": "firebase emulators:start --only auth,database,firestore,storage,functions,hosting --project dawa-aa793",
    "emulators:build": "cd functions && npm run build && cd .. && npm run emulators",
    "emulators:seed": "node scripts/seed-emulator.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "firebase emulators:exec --only database --project demo-dawa-test \"vitest run --project integration\"",
    "test:watch": "firebase emulators:exec --only database --project demo-dawa-test \"vitest --project integration\"",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "face-api.js": "^0.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "firebase-tools": "^15.18.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.11",
    "vitest": "^4.1.6"
  }
}
