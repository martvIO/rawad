{
  "name": "dawa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "دعوة — wedding-invitation distribution app (root orchestrator; app code lives in frontend/ and backend/)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:emulator": "npm --prefix frontend run dev:emulator",
    "dev:full": "concurrently -k -n EMU,VITE -c blue,green \"npm:emulators:build\" \"npm:dev:emulator\"",
    "emulators": "firebase emulators:start --only auth,database,firestore,storage,functions,hosting --project dawa-aa793",
    "emulators:build": "node backend/scripts/build-functions.cjs && npm run emulators",
    "emulators:seed": "node backend/scripts/seed-emulator.cjs",
    "migrate:digits": "node backend/scripts/migrate-arabic-digits.cjs",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "firebase emulators:exec --only database --project demo-dawa-test \"vitest run -c backend/vitest.config.js --project integration\"",
    "test:watch": "firebase emulators:exec --only database --project demo-dawa-test \"vitest -c backend/vitest.config.js --project integration\"",
    "test:unit": "npm --prefix frontend run test:unit && vitest run -c backend/vitest.config.js --project unit",
    "test:unit:watch": "npm --prefix frontend run test:unit:watch",
    "test:coverage": "npm --prefix frontend run test:coverage",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:ui": "npm --prefix frontend run test:e2e:ui",
    "test:e2e:headed": "npm --prefix frontend run test:e2e:headed",
    "test:e2e:report": "npm --prefix frontend run test:e2e:report"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "concurrently": "^9.2.1",
    "firebase-tools": "^15.18.0",
    "vitest": "^4.1.6"
  }
}
