{
  "rules": {
    ".read": false,
    ".write": false,

    "securityBlocks": {
      // Server-only (Admin SDK). Account / IP / fingerprint deny-lists written
      // by the security API + auto-blocker and read via the /admin/security REST
      // endpoint — never client-readable or -writable. Explicit deny mirrors the
      // default-deny root so nobody opens the subtree by accident.
      ".read": false,
      ".write": false
    },

    "users": {
      // مدير يقرأ القائمة كاملة؛ كل مستخدم يقرأ سجله الخاص فقط
      ".read": "auth != null && auth.token.role === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['username','role','createdAt'])",
        "username":    {
          ".read": "auth != null && root.child('driverAssignments').child(auth.uid).child($uid).val() === true",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60 && newData.val().matches(/^[a-zA-Z0-9_.-]+$/)"
        },
        "role":        {
          ".read": "auth != null && root.child('driverAssignments').child(auth.uid).child($uid).val() === true",
          ".validate": "newData.val() === 'groom' || newData.val() === 'driver' || newData.val() === 'admin'"
        },
        "phoneE164":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^\\+[1-9][0-9]{6,14}$/))" },
        "displayName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "createdAt":   { ".validate": "newData.isNumber()" },
        "createdBy":   { ".validate": "!newData.exists() || newData.isString()" },
        "paymentPlan":      { ".validate": "!newData.exists() || newData.val() === 'premium' || newData.val() === 'vip'" },
        "paymentStatus":    { ".validate": "!newData.exists() || newData.val() === 'none' || newData.val() === 'pending' || newData.val() === 'paid' || newData.val() === 'failed'" },
        "paymentAmountIls": { ".validate": "!newData.exists() || newData.isNumber()" },
        "paymentLinkUrl":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
        "paymentLinkId":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
        "paymentCreatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "paymentPaidAt":    { ".validate": "!newData.exists() || newData.isNumber()" },
        "paymentMode":      { ".validate": "!newData.exists() || newData.val() === 'test' || newData.val() === 'live'" },
        // Paid-signup flow: which package the groom bought + the forced
        // first-login password-change flag (cleared on change). See payments.ts.
        "paymentPackageId":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "mustChangePassword": { ".validate": "!newData.exists() || newData.isBoolean()" },
        // First-sign-in onboarding: the couple's bride/groom names + wedding date
        // (written by POST /auth/onboarding via Admin SDK) and the onboarding-done
        // flag that clears the onboarding gate. Seed the first digital design.
        "brideName":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "groomName":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "weddingDate": { ".validate": "!newData.exists() || newData.isNumber()" },
        "onboardedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "lifecycleStatus":   { ".validate": "!newData.exists() || newData.val() === 'active' || newData.val() === 'cancel_pending' || newData.val() === 'cancelled' || newData.val() === 'paused'" },
        "cancelRequestedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "cancelGraceEndsAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "cancelReason":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
        "cancelledAt":       { ".validate": "!newData.exists() || newData.isNumber()" },
        "pausedAt":          { ".validate": "!newData.exists() || newData.isNumber()" },
        "pausedNewDate":     { ".validate": "!newData.exists() || newData.isNumber()" },
        "statusUpdatedBy":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "$other":      { ".validate": false }
      }
    },

    // قائمة عامة (للقراءة فقط) تحتوي على username + displayName لكل عريس.
    // تُقرأ من قِبل المرسلين لاختيار من يشاركونه موقعهم أو البلدات المشتركة.
    // تُكتب من قِبل الأدمن فقط؛ تُحدَّث تلقائياً عند إنشاء/تعديل/حذف عريس.
    "groomProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.token.role === 'admin'",
        ".validate": "!newData.exists() || newData.hasChildren(['username'])",
        "username":    { ".validate": "newData.isString() && newData.val().length > 0" },
        "displayName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "$other":      { ".validate": false }
      }
    },

    "usernameIndex": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.isString() && root.child('users').child(newData.val()).exists()"
      }
    },

    "phoneIndex": {
      ".read": false,
      "$phone": {
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.isString() && root.child('users').child(newData.val()).exists()"
      }
    },

    "guestsByGroom": {
      ".read": "auth != null && auth.token.role === 'admin'",
      "$groomUid": {
        ".read":  "auth != null && ($groomUid === auth.uid || root.child('driverAssignments').child(auth.uid).child($groomUid).val() === true)",
        ".indexOn": ["status", "inviteType"],
        "$guestId": {
          ".write": "auth != null && (auth.token.role === 'admin' || $groomUid === auth.uid || (data.exists() && root.child('driverAssignments').child(auth.uid).child($groomUid).val() === true))",
          ".validate": "newData.hasChildren(['name','phone','status','inviteType'])",
          "groomUsername":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
          "name":           { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "phone":          { ".validate": "newData.isString() && newData.val().length <= 30" },
          "area":           { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
          "status":         { ".validate": "newData.val() === 'pending' || newData.val() === 'enroute' || newData.val() === 'delivered' || newData.val() === 'no_answer' || newData.val() === 'wrong_address' || newData.val() === 'refused'" },
          "inviteType":     { ".validate": "newData.val() === 'premium' || newData.val() === 'vip'" },
          "proofPhotoPath": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
          "deliveredAt":    { ".validate": "!newData.exists() || newData.isString()" },
          "deliveredBy":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
          "deliveryNote":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
          "createdAt":      { ".validate": "!newData.exists() || newData.isNumber()" },
          "lat":              { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -90  && newData.val() <= 90)" },
          "lng":              { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -180 && newData.val() <= 180)" },
          "locationAccuracy": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000)" },
          "locationSource":   { ".validate": "!newData.exists() || newData.val() === 'gps' || newData.val() === 'manual'" },
          "locationUpdatedAt":{ ".validate": "!newData.exists() || newData.isNumber()" },
          "inviteLinkToken":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
          "inviteLinkSentAt": { ".validate": "!newData.exists() || newData.isNumber()" },
          "inviteWaStatus":    { ".validate": "!newData.exists() || newData.val() === 'sent' || newData.val() === 'delivered' || newData.val() === 'read' || newData.val() === 'failed' || newData.val() === 'manual'" },
          "inviteWaMessageId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
          "inviteWaSentAt":    { ".validate": "!newData.exists() || newData.isNumber()" },
          "inviteWaStatusAt":  { ".validate": "!newData.exists() || newData.isNumber()" },
          "inviteWaError":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
          "confirmedAt":      { ".validate": "!newData.exists() || newData.isNumber()" },
          "companions":       { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20)" },
          "$other":         { ".validate": false }
        }
      }
    },

    "liveLocationsByGroom": {
      "$groomUid": {
        ".read": "auth != null && (auth.token.role === 'admin' || $groomUid === auth.uid)",
        "$driverUid": {
          // A driver may only publish their OWN location, and only to a groom
          // they are actually assigned to (defense-in-depth mirroring the
          // assignment filter in routes/liveLocations.ts). Clearing (writing
          // null) is always allowed so an unassigned driver can remove a stale
          // share. The REST path uses the Admin SDK (bypasses rules); this
          // guards any direct client RTDB write.
          ".write": "auth != null && $driverUid === auth.uid && (!newData.exists() || root.child('driverAssignments').child(auth.uid).child($groomUid).val() === true)",
          ".validate": "newData.hasChildren(['lat','lng','timeISO'])",
          "lat":      { ".validate": "newData.isNumber() && newData.val() >= -90  && newData.val() <= 90" },
          "lng":      { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "accuracy": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000)" },
          "timeISO":            { ".validate": "newData.isString() && newData.val().length <= 40" },
          "driverDisplayName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
          "$other":            { ".validate": false }
        }
      }
    },

    "confirmations": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": false,
      ".indexOn": ["groomUid", "confirmedAt"],
      "$confId": {
        ".write": "auth != null && auth.token.role === 'admin' && data.exists()",
        ".validate": "newData.hasChildren(['groomUid','submittedName','submittedPhone','confirmedAt'])",
        "groomUid":        { ".validate": "newData.isString() && newData.val().length <= 64" },
        "groomUsername":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
        "submittedName":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "submittedPhone":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "submittedCity":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
        "submittedStreet": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "submittedHouse":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)" },
        "deliveryNote":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
        "lat":               { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -90  && newData.val() <= 90)" },
        "lng":               { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -180 && newData.val() <= 180)" },
        "locationAccuracy":  { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000)" },
        "locationCapturedAt":{ ".validate": "!newData.exists() || newData.isNumber()" },
        "attachedGuestId":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "confirmedAt":     { ".validate": "newData.isNumber()" },
        "companions":      { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20)" },
        "$other":          { ".validate": false }
      }
    },

    "adminSettings": {
      ".read":  "auth != null",
      ".write": "auth != null && auth.token.role === 'admin'",
      "messageBody":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 4000)" },
      "formLink":       { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000 && (newData.val().length === 0 || newData.val().matches(/^https:\\/\\//)))" },
      "mode":           { ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'manual' || newData.val() === 'digital'))" },
      "digitalBaseUrl": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000 && (newData.val().length === 0 || newData.val().matches(/^https:\\/\\//)))" },
      "digitalMessage": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 4000)" },
      "contactWhatsapp":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 32)" },
      "contactPhone":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 32)" },
      "contactEmail":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
      "socialFacebook":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500 && (newData.val().length === 0 || newData.val().matches(/^https:\\/\\//)))" },
      "socialInstagram":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500 && (newData.val().length === 0 || newData.val().matches(/^https:\\/\\//)))" },
      "socialTiktok":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500 && (newData.val().length === 0 || newData.val().matches(/^https:\\/\\//)))" },
      "cancelGraceHours":        { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 720)" },
      "contactWhatsappEnabled":  { ".validate": "!newData.exists() || newData.isBoolean()" },
      "contactPhoneEnabled":     { ".validate": "!newData.exists() || newData.isBoolean()" },
      "contactEmailEnabled":     { ".validate": "!newData.exists() || newData.isBoolean()" },
      "socialFacebookEnabled":   { ".validate": "!newData.exists() || newData.isBoolean()" },
      "socialInstagramEnabled":  { ".validate": "!newData.exists() || newData.isBoolean()" },
      "socialTiktokEnabled":     { ".validate": "!newData.exists() || newData.isBoolean()" },
      "waPhoneId":         { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
      "waWabaId":          { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
      "waVerifyToken":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
      "waAutoSendEnabled": { ".validate": "!newData.exists() || newData.isBoolean()" },
      "waDailyCap":        { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000)" },
      "waFallbackTextAr":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 4000)" },
      "waFallbackTextHe":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 4000)" },
      "waTemplatePhysicalAr": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
      "waTemplatePhysicalHe": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
      "waTemplateDigitalAr":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
      "waTemplateDigitalHe":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
      "waTemplateCredentialsAr": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
      "waTemplateCredentialsHe": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
      "$other":         { ".validate": false }
    },

    "inviteTokens": {
      "$token": {
        // No direct client read OR write. The token record holds guest PII
        // (name/phone) + the full digital designSnapshot; it is minted and read
        // ONLY through the admin-gated server endpoints (POST /invites[/digital]
        // + GET /invites/token/:token), all via the Admin SDK which bypasses
        // these rules. Closing both sides keeps a client (even an authenticated
        // groom holding their own Firebase ID token) from minting tokens
        // directly against the RTDB REST API — which would bypass the admin
        // gate, the per-user mint rate limit, and the audit log — or reading the
        // raw record. Same Function-only pattern as confirmations/audit/galleryGrants.
        ".read":  false,
        ".write": false,
        ".validate": "!newData.exists() || newData.hasChildren(['groomUid','groomUsername','guestId','guestName','guestPhone','createdAt','expiresAt'])",
        "groomUid":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "groomUsername": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "guestId":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
        "guestName":     { ".validate": "newData.isString() && newData.val().length <= 120" },
        "guestPhone":    { ".validate": "newData.isString() && newData.val().length <= 30" },
        "guestType":     { ".validate": "!newData.exists() || newData.val() === 'physical' || newData.val() === 'digital'" },
        "createdAt":     { ".validate": "newData.isNumber()" },
        "expiresAt":     { ".validate": "newData.isNumber()" },
        "usedAt":        { ".validate": "!newData.exists() || newData.isNumber()" },
        "$other":        { ".validate": false }
      }
    },

    "waMessages": {
      // Reverse index wamid → { groomUid, guestId, type } written when an invite
      // is auto-sent over WhatsApp, so the Meta delivery/read webhook can map a
      // receipt back to the guest record. Server-only (Admin SDK bypasses these);
      // no client read/write — same Function-only pattern as inviteTokens.
      ".read": false,
      ".write": false,
      "$messageId": {
        "groomUid": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "guestId":  { ".validate": "newData.isString() && newData.val().length <= 64" },
        "type":     { ".validate": "newData.val() === 'physical' || newData.val() === 'digital'" },
        "sentAt":   { ".validate": "newData.isNumber()" },
        "$other":   { ".validate": false }
      }
    },

    "galleryGrants": {
      // Short-lived People-gallery access grants, minted ONLY by the server
      // after phone-OTP + guest-list membership. Server-only (Admin SDK bypasses
      // these); no client read/write. Keyed galleryGrants/{groomUid}/{tokenHash}.
      ".read": false,
      ".write": false,
      "$groomUid": {
        "$tokenHash": {
          "phoneE164": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "expiresAt": { ".validate": "newData.isNumber()" },
          "$other":    { ".validate": false }
        }
      }
    },

    "paymentTokens": {
      // Paid-signup links. Function-only: minted + read ONLY through the
      // admin-gated server endpoints (POST/GET /payments/links[/:token]) and the
      // Stripe webhook, all via the Admin SDK which bypasses these rules. Closing
      // both sides keeps a client from minting paid-signup tokens or reading
      // reserved usernames / PaymentIntent ids. Same pattern as inviteTokens.
      ".read": false,
      ".write": false,
      "$token": {
        ".validate": "!newData.exists() || newData.hasChildren(['role','packageId','status','createdAt','expiresAt'])",
        "role":             { ".validate": "newData.val() === 'groom'" },
        "packageId":        { ".validate": "newData.isString() && newData.val().length <= 64" },
        "status":           { ".validate": "newData.val() === 'pending' || newData.val() === 'reserved' || newData.val() === 'provisioning' || newData.val() === 'paid' || newData.val() === 'delivered' || newData.val() === 'delivery_failed' || newData.val() === 'amount_mismatch' || newData.val() === 'account_conflict'" },
        "createdAt":        { ".validate": "newData.isNumber()" },
        "expiresAt":        { ".validate": "newData.isNumber()" },
        "claimedAt":        { ".validate": "!newData.exists() || newData.isNumber()" },
        "createdBy":        { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "reservedUsername": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
        "reservedPhoneE164":{ ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)" },
        "lang":             { ".validate": "!newData.exists() || newData.val() === 'ar' || newData.val() === 'he'" },
        "paidAt":           { ".validate": "!newData.exists() || newData.isNumber()" },
        "createdUid":       { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "deliveredAt":      { ".validate": "!newData.exists() || newData.isNumber()" },
        "deliveryError":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
        "$other":           { ".validate": false }
      }
    },

    "usernameReservations": {
      // Function-only soft reservations: a username held while a groom completes
      // a Stripe payment, so account creation at the webhook can't collide. Admin
      // SDK only; clients never read/write. TTL'd by expiresAt (checked in code).
      ".read": false,
      ".write": false,
      "$username": {
        ".validate": "!newData.exists() || newData.hasChildren(['token','expiresAt'])",
        "token":         { ".validate": "newData.isString() && newData.val().length <= 64" },
        "expiresAt":     { ".validate": "newData.isNumber()" },
        "phoneIndexKey": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)" },
        "$other":        { ".validate": false }
      }
    },

    "phoneReservations": {
      // Function-only soft reservations on the phone number — the symmetric twin
      // of usernameReservations, so two distinct paid links can't both provision
      // an account on the same phone. Admin SDK only; TTL'd by expiresAt.
      ".read": false,
      ".write": false,
      "$phoneIdx": {
        ".validate": "!newData.exists() || newData.hasChildren(['token','expiresAt'])",
        "token":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "expiresAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    },

    "generatedPasswords": {
      // Admin-visible fallback password for a generated-credentials account
      // (paid signup AND admin-created groom/driver), kept ONLY until the
      // user's forced first-login change purges it. Stored as an enc:v1
      // RSA-OAEP envelope (~351 chars; legacy entries may be plaintext).
      // Function-only: the admin reads it through GET /payments/links or
      // GET /users/:uid/temp-password (Admin SDK, decrypt-on-read), NEVER a
      // direct client RTDB listener — so a password is never exposed to a
      // client subscription. Same Function-only pattern as galleryGrants.
      ".read": false,
      ".write": false,
      "$uid": {
        "password":  { ".validate": "newData.isString() && newData.val().length <= 512" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "token":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "$other":    { ".validate": false }
      }
    },

    "purchases": {
      // Append-only ledger of completed package purchases, keyed by the link
      // token (one purchase per single-use link → idempotent on webhook retry).
      // Admin-read for the payments dashboard; Function-write only (Admin SDK
      // bypasses rules).
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": false,
      ".indexOn": ["uid", "paidAt"],
      "$token": {
        ".validate": "newData.hasChildren(['uid','packageId','amountIls','paidAt'])",
        "uid":            { ".validate": "newData.isString() && newData.val().length <= 64" },
        "packageId":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "amountIls":      { ".validate": "newData.isNumber()" },
        "amountPaidCents":{ ".validate": "!newData.exists() || newData.isNumber()" },
        "currency":       { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 8)" },
        "token":          { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "orderId":        { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
        "status":         { ".validate": "!newData.exists() || newData.val() === 'paid'" },
        "paidAt":         { ".validate": "newData.isNumber()" },
        "$other":         { ".validate": false }
      }
    },

    "driverAssignments": {
      "$driverUid": {
        ".read":  "auth != null && (auth.token.role === 'admin' || $driverUid === auth.uid)",
        ".write": false,
        "$groomUid": { ".validate": "newData.val() === true" }
      }
    },

    "audit": {
      ".read":  "auth != null && auth.token.role === 'admin'",
      ".write": false,
      ".indexOn": ["timestamp", "uid", "action"],
      "$eventId": {
        ".validate": "newData.hasChildren(['uid','action','timestamp'])"
      }
    }
  }
}
