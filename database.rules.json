{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      // مدير يقرأ القائمة كاملة؛ كل مستخدم يقرأ سجله الخاص فقط
      ".read": "auth != null && auth.token.role === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['username','role','createdAt'])",
        "username":    {
          ".read": "auth != null && root.child('driverAssignments').child(auth.uid).child($uid).val() === true",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60 && newData.val().matches(/^[a-zA-Z0-9_.-]+$/)"
        },
        "role":        {
          ".read": "auth != null && root.child('driverAssignments').child(auth.uid).child($uid).val() === true",
          ".validate": "newData.val() === 'groom' || newData.val() === 'driver' || newData.val() === 'admin'"
        },
        "phoneE164":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^\\+[1-9][0-9]{6,14}$/))" },
        "displayName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "createdAt":   { ".validate": "newData.isNumber()" },
        "createdBy":   { ".validate": "!newData.exists() || newData.isString()" },
        "$other":      { ".validate": false }
      }
    },

    // قائمة عامة (للقراءة فقط) تحتوي على username + displayName لكل عريس.
    // تُقرأ من قِبل المرسلين لاختيار من يشاركونه موقعهم أو البلدات المشتركة.
    // تُكتب من قِبل الأدمن فقط؛ تُحدَّث تلقائياً عند إنشاء/تعديل/حذف عريس.
    "groomProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.token.role === 'admin'",
        ".validate": "!newData.exists() || newData.hasChildren(['username'])",
        "username":    { ".validate": "newData.isString() && newData.val().length > 0" },
        "displayName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "$other":      { ".validate": false }
      }
    },

    "usernameIndex": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.isString() && root.child('users').child(newData.val()).exists()"
      }
    },

    "phoneIndex": {
      ".read": false,
      "$phone": {
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.isString() && root.child('users').child(newData.val()).exists()"
      }
    },

    "guestsByGroom": {
      ".read": "auth != null && auth.token.role === 'admin'",
      "$groomUid": {
        ".read":  "auth != null && ($groomUid === auth.uid || root.child('driverAssignments').child(auth.uid).child($groomUid).val() === true)",
        ".indexOn": ["status", "inviteType"],
        "$guestId": {
          ".write": "auth != null && (auth.token.role === 'admin' || $groomUid === auth.uid || (data.exists() && root.child('driverAssignments').child(auth.uid).child($groomUid).val() === true))",
          ".validate": "newData.hasChildren(['name','phone','status','inviteType'])",
          "groomUsername":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
          "name":           { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "phone":          { ".validate": "newData.isString() && newData.val().length <= 30" },
          "area":           { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
          "status":         { ".validate": "newData.val() === 'pending' || newData.val() === 'enroute' || newData.val() === 'delivered'" },
          "inviteType":     { ".validate": "newData.val() === 'premium' || newData.val() === 'vip'" },
          "proofPhotoPath": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
          "deliveredAt":    { ".validate": "!newData.exists() || newData.isString()" },
          "deliveredBy":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
          "deliveryNote":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)" },
          "createdAt":      { ".validate": "!newData.exists() || newData.isNumber()" },
          "lat":              { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -90  && newData.val() <= 90)" },
          "lng":              { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -180 && newData.val() <= 180)" },
          "locationAccuracy": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000)" },
          "locationSource":   { ".validate": "!newData.exists() || newData.val() === 'gps' || newData.val() === 'manual'" },
          "locationUpdatedAt":{ ".validate": "!newData.exists() || newData.isNumber()" },
          "inviteLinkToken":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
          "inviteLinkSentAt": { ".validate": "!newData.exists() || newData.isNumber()" },
          "confirmedAt":      { ".validate": "!newData.exists() || newData.isNumber()" },
          "companions":       { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20)" },
          "$other":         { ".validate": false }
        }
      }
    },

    "liveLocationsByGroom": {
      "$groomUid": {
        ".read": "auth != null && (auth.token.role === 'admin' || $groomUid === auth.uid)",
        "$driverUid": {
          ".write": "auth != null && $driverUid === auth.uid",
          ".validate": "newData.hasChildren(['lat','lng','timeISO'])",
          "lat":      { ".validate": "newData.isNumber() && newData.val() >= -90  && newData.val() <= 90" },
          "lng":      { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "accuracy": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000)" },
          "timeISO":            { ".validate": "newData.isString() && newData.val().length <= 40" },
          "driverDisplayName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
          "$other":            { ".validate": false }
        }
      }
    },

    "confirmations": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": false,
      ".indexOn": ["groomUid", "confirmedAt"],
      "$confId": {
        ".write": "auth != null && auth.token.role === 'admin' && data.exists()",
        ".validate": "newData.hasChildren(['groomUid','submittedName','submittedPhone','confirmedAt'])",
        "groomUid":        { ".validate": "newData.isString() && newData.val().length <= 64" },
        "groomUsername":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
        "submittedName":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "submittedPhone":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "submittedCity":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
        "submittedStreet": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "submittedHouse":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)" },
        "lat":               { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -90  && newData.val() <= 90)" },
        "lng":               { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -180 && newData.val() <= 180)" },
        "locationAccuracy":  { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000)" },
        "locationCapturedAt":{ ".validate": "!newData.exists() || newData.isNumber()" },
        "attachedGuestId":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "confirmedAt":     { ".validate": "newData.isNumber()" },
        "companions":      { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20)" },
        "$other":          { ".validate": false }
      }
    },

    "adminSettings": {
      ".read":  "auth != null",
      ".write": "auth != null && auth.token.role === 'admin'",
      "messageBody": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 4000)" },
      "formLink":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000 && newData.val().matches(/^https:\\/\\//))" },
      "$other":      { ".validate": false }
    },

    "inviteTokens": {
      "$token": {
        ".read":  true,
        ".write": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'groom' && (!newData.exists() || newData.child('groomUid').val() === auth.uid)))",
        ".validate": "!newData.exists() || newData.hasChildren(['groomUid','groomUsername','guestId','guestName','guestPhone','createdAt','expiresAt'])",
        "groomUid":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "groomUsername": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "guestId":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
        "guestName":     { ".validate": "newData.isString() && newData.val().length <= 120" },
        "guestPhone":    { ".validate": "newData.isString() && newData.val().length <= 30" },
        "guestType":     { ".validate": "!newData.exists() || newData.val() === 'physical' || newData.val() === 'digital'" },
        "createdAt":     { ".validate": "newData.isNumber()" },
        "expiresAt":     { ".validate": "newData.isNumber()" },
        "usedAt":        { ".validate": "!newData.exists() || newData.isNumber()" },
        "$other":        { ".validate": false }
      }
    },

    "driverAssignments": {
      "$driverUid": {
        ".read":  "auth != null && (auth.token.role === 'admin' || $driverUid === auth.uid)",
        ".write": false,
        "$groomUid": { ".validate": "newData.val() === true" }
      }
    },

    "audit": {
      ".read":  "auth != null && auth.token.role === 'admin'",
      ".write": false,
      ".indexOn": ["timestamp", "uid", "action"],
      "$eventId": {
        ".validate": "newData.hasChildren(['uid','action','timestamp'])"
      }
    }
  }
}
